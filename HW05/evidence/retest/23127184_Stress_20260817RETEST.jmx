<?xml version="1.0" encoding="UTF-8"?>
<!--
  plan-skeleton.jmx — outer shell of a generated JMeter test plan.

  Placeholders replaced by scripts/new-plan.ps1 are written in double braces
  below. They are named here without the braces on purpose: writing them
  literally would make the generator substitute into its own documentation, and
  injecting a thread group into an XML comment breaks the file.

    PLAN_NAME      test plan name, e.g. 23127184_Load_20260815
    HOST           target host
    PORT           target port
    DATA_DIR       absolute path to the CSV directory
    THREAD_GROUPS  one or more ThreadGroup blocks, each carrying a copy of
                   the workflow fragment
    LISTENER       the scenario's listener element

  Config elements sit at test-plan level so every thread group inherits them.
  CSV Data Set Configs are shared here on purpose: a thread pulls the next row
  from a shared pool, which is what makes 200 threads exercise 200 different
  rows instead of 200 copies of row one.
-->
<jmeterTestPlan version="1.2" properties="5.0" jmeter="5.6.3">
  <hashTree>
    <TestPlan guiclass="TestPlanGui" testclass="TestPlan" testname="23127184_Stress_20260817RETEST" enabled="true">
      <stringProp name="TestPlan.comments">Generated by perf-implement-and-run. Do not hand-edit; regenerate instead. SIZING: Four-stage staircase to 198 VU; estimated peak 78.2 iterations/s (238% of sizing capacity). measured: 32.9 iterations/s, scaled x0.87 from the 38 example</stringProp>
      <boolProp name="TestPlan.functional_mode">false</boolProp>
      <boolProp name="TestPlan.serialize_threadgroups">false</boolProp>
      <elementProp name="TestPlan.user_defined_variables" elementType="Arguments" guiclass="ArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
        <collectionProp name="Arguments.arguments"/>
      </elementProp>
      <stringProp name="TestPlan.user_define_classpath"></stringProp>
    </TestPlan>
    <hashTree>

      <ConfigTestElement guiclass="HttpDefaultsGui" testclass="ConfigTestElement" testname="HTTP Request Defaults" enabled="true">
        <elementProp name="HTTPsampler.Arguments" elementType="Arguments" guiclass="HTTPArgumentsPanel" testclass="Arguments" testname="User Defined Variables" enabled="true">
          <collectionProp name="Arguments.arguments"/>
