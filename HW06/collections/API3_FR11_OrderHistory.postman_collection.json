{
  "info": {
    "_postman_id": "44750fa2-73db-4390-83b7-f5f8998cbeee",
    "name": "API3 - FR-11 Order History (GET /api/orders/my-orders)",
    "description": "HW06 / Pool B / FR-11.\n\nSpec: GET /api/orders/my-orders (Bearer token) -> the caller's orders. FR-11 states a user may only see their own orders, which makes this the natural home for IDOR / ownership testing, and for the FR-10 order state machine as it is observed through order history.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "00 - Setup",
      "item": [
        {
          "name": "SETUP-001 | Log in as the primary user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Login succeeded\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property(\"token\");",
                  "});",
                  "",
                  "const body = pm.response.json();",
                  "pm.environment.set(\"user_token\", body.token);",
                  "if (body.user) {",
                  "    pm.environment.set(\"user_token_user_id\", body.user.id);",
                  "    pm.environment.set(\"user_token_role\", body.user.role);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{user_email}}\",\n  \"password\": \"{{user_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "description": "Setup step: obtains a JWT used by later requests in this collection."
          },
          "response": []
        },
        {
          "name": "SETUP-002 | Create an order owned by the primary user",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Checkout created an order\", function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json()).to.have.property(\"orderId\");",
                  "});",
                  "pm.environment.set(\"own_order_id\", pm.response.json().orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_amount\": 250000,\n  \"shipping_address\": \"123 Le Loi, Q1, TP.HCM\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "SETUP-003 | Register + log in a second user (the victim)",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const email = pm.variables.replaceIn(\"{{$guid}}\") + \"@victim.com\";",
                  "const password = \"Victim123!\";",
                  "pm.environment.set(\"victim_email\", email);",
                  "pm.environment.set(\"victim_password\", password);",
                  "pm.sendRequest({",
                  "    url: pm.environment.get(\"base_url\") + \"/api/register\",",
                  "    method: \"POST\",",
                  "    header: { \"Content-Type\": \"application/json\",",
                  "              \"X-Student-Id\": pm.environment.get(\"student_id\") },",
                  "    body: { mode: \"raw\", raw: JSON.stringify({ name: \"Victim\", email, password }) }",
                  "}, function () { console.log(\"[HW06] victim account created: \" + email); });"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Victim account is usable\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"victim_token\", pm.response.json().token);",
                  "pm.environment.set(\"victim_user_id\", pm.response.json().user.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/login",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{victim_email}}\",\n  \"password\": \"{{victim_password}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        },
        {
          "name": "SETUP-004 | Create an order owned by the victim",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Victim order created\", () => pm.response.to.have.status(200));",
                  "pm.environment.set(\"victim_order_id\", pm.response.json().orderId);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{victim_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/checkout",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "checkout"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"total_amount\": 777000,\n  \"shipping_address\": \"99 Victim Street\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": []
        }
      ],
      "description": "Builds the two-user fixture that ownership and IDOR cases depend on."
    },
    {
      "name": "01 - Domain partitions",
      "item": [
        {
          "name": "DP-001 | Authenticated user receives their own order list",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                  "pm.test(\"Response is an array\", function () {",
                  "    pm.expect(pm.response.json()).to.be.an(\"array\");",
                  "});",
                  "pm.test(\"Every returned order belongs to the caller\", function () {",
                  "    const me = Number(pm.environment.get(\"user_token_user_id\"));",
                  "    pm.response.json().forEach(function (o) {",
                  "        pm.expect(o.user_id, \"order \" + o.id + \" owner\").to.eql(me);",
                  "    });",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/my-orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "my-orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "DP-002 | Missing token is rejected",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Unauthenticated request returns 401\", function () {",
                  "    pm.response.to.have.status(401);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/my-orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "my-orders"
              ]
            }
          },
          "response": []
        }
      ],
      "description": ""
    },
    {
      "name": "02 - State transitions (FR-10)",
      "item": [
        {
          "name": "ST-001 | A new order appears in history as 'pending'",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"The order created in setup is listed as pending\", function () {",
                  "    const target = Number(pm.environment.get(\"own_order_id\"));",
                  "    const found = pm.response.json().find(o => o.id === target);",
                  "    pm.expect(found, \"order \" + target + \" in history\").to.not.be.undefined;",
                  "    pm.expect(found.status).to.eql(\"pending\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/my-orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "my-orders"
              ]
            }
          },
          "response": []
        },
        {
          "name": "ST-002 | Cancelling a pending order is reflected in history",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cancel from 'pending' is allowed\", () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/{{own_order_id}}/cancel",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{own_order_id}}",
                "cancel"
              ]
            }
          },
          "response": []
        }
      ],
      "description": "pending -> confirmed -> shipping -> delivered plus cancellation rules, observed through order history."
    },
    {
      "name": "03 - Security (SEC-01..SEC-07)",
      "item": [
        {
          "name": "SEC-02 | Reading another user's order requires authentication (IDOR)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// SEC-02: security-relevant APIs require a valid JWT.",
                  "// FR-11: a user may only see their own orders.",
                  "pm.test(\"Unauthenticated read of an arbitrary order is refused\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([401, 403, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{base_url}}/api/orders/{{victim_order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{victim_order_id}}"
              ]
            }
          },
          "response": []
        },
        {
          "name": "SEC-02b | User A cannot read user B's order with their own token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test(\"Cross-user order read is refused\", function () {",
                  "    pm.expect(pm.response.code).to.be.oneOf([403, 404]);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/{{victim_order_id}}",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "{{victim_order_id}}"
              ]
            }
          },
          "response": []
        }
      ],
      "description": ""
    },
    {
      "name": "04 - Schema validation",
      "item": [
        {
          "name": "SCH-001 | Order-history entries match the orders schema",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const schema = {",
                  "    type: \"array\",",
                  "    items: {",
                  "        type: \"object\",",
                  "        required: [\"id\", \"user_id\", \"total_amount\", \"status\", \"shipping_address\", \"created_at\"],",
                  "        properties: {",
                  "            id: { type: \"integer\" },",
                  "            user_id: { type: \"integer\" },",
                  "            total_amount: { type: \"number\" },",
                  "            status: { type: \"string\",",
                  "                      enum: [\"pending\", \"confirmed\", \"shipping\", \"delivered\", \"canceled\"] },",
                  "            shipping_address: { type: [\"string\", \"null\"] },",
                  "            created_at: { type: \"string\" }",
                  "        }",
                  "    }",
                  "};",
                  "",
                  "pm.test(\"Order history conforms to the schema\", function () {",
                  "    pm.response.to.have.jsonSchema(schema);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{user_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/api/orders/my-orders",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "orders",
                "my-orders"
              ]
            }
          },
          "response": []
        }
      ],
      "description": ""
    }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ---------------------------------------------------------------------------",
          "// HW06 mandatory harness: every request must carry X-Student-Id.",
          "// The console line below is the anti-AI-cheat evidence (Section 11 of the",
          "// brief) - screenshot the Postman console showing it.",
          "// ---------------------------------------------------------------------------",
          "const studentId = pm.environment.get(\"student_id\") || \"23127184\";",
          "",
          "pm.request.headers.upsert({ key: \"X-Student-Id\", value: studentId });",
          "",
          "// Tag each run so Newman output and SUT state can be correlated.",
          "if (!pm.environment.get(\"run_tag\")) {",
          "    pm.environment.set(\"run_tag\", \"run-\" + Date.now());",
          "}",
          "",
          "console.log(",
          "    \"[HW06] X-Student-Id=\" + studentId +",
          "    \" | \" + pm.request.method + \" \" + pm.request.url.toString() +",
          "    \" | run_tag=\" + pm.environment.get(\"run_tag\")",
          ");"
        ]
      }
    },
    {
      "listen": "test",
      "script": {
        "type": "text/javascript",
        "exec": [
          "// ---------------------------------------------------------------------------",
          "// Assertions that apply to every request in the collection.",
          "// ---------------------------------------------------------------------------",
          "pm.test(\"Request carried the X-Student-Id header\", function () {",
          "    const sent = pm.request.headers.get(\"X-Student-Id\");",
          "    pm.expect(sent, \"X-Student-Id header\").to.eql(",
          "        pm.environment.get(\"student_id\") || \"23127184\"",
          "    );",
          "});",
          "",
          "pm.test(\"Response is not rate-limited (HTTP 429)\", function () {",
          "    pm.expect(",
          "        pm.response.code,",
          "        \"Backend rate limiter tripped - start the SUT with LOADTEST=1\"",
          "    ).to.not.eql(429);",
          "});",
          "",
          "pm.test(\"Response arrived under 2000 ms\", function () {",
          "    pm.expect(pm.response.responseTime).to.be.below(2000);",
          "});"
        ]
      }
    }
  ],
  "variable": []
}