                  "id": "fe117f11-0e5e-4690-b845-06a7a25af9ce",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Product list is available\", () => pm.response.to.have.status(200));",
                    "const list = pm.response.json();",
                    "if (Array.isArray(list) && list.length) {",
