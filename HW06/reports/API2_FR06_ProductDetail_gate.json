      {
        "id": "41773210-9be9-4ad1-b201-60157430b660",
        "name": "01 - Domain partitions",
        "description": {
          "content": "Partitions on :id - valid / non-existent / zero / negative / non-numeric / overflow / injection.",
          "type": "text/plain"
        },
        "item": [
          {
            "id": "a5323d64-2ff0-4d25-9aaf-261585d36e91",
            "name": "DP-001 | Existing id returns that product",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "{{existing_product_id}}"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "c53a7a9c-1bd7-419a-8331-755229761445",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                    "pm.test(\"Returned product is the one requested\", function () {",
                    "    pm.expect(String(pm.response.json().id)).to.eql(",
                    "        String(pm.environment.get(\"existing_product_id\"))",
                    "    );",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "c8c4ecf0-9f09-40bd-83d5-179ebe3ed60d",
            "name": "DP-002 | Non-existent id returns 404",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "999999"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "a941dbeb-bb94-4232-b0bd-18cc81d64ae7",
                  "type": "text/javascript",
                  "exec": [
                    "// Spec/REST contract: an unknown resource is 404, not 200 with an empty body.",
                    "pm.test(\"Unknown product id returns 404\", function () {",
                    "    pm.response.to.have.status(404);",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "c5aab5d5-9c79-4af1-8b9e-fd0d4c5cfca9",
            "name": "DP-003 | Non-numeric id is rejected",
            "request": {
              "url": {
                "path": [
                  "api",
