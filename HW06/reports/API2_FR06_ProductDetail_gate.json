      {
        "id": "46f2afd2-2ba5-4264-a4bf-9da52fef94e2",
        "name": "01 - Domain partitions",
        "description": {
          "content": "Partitions on :id - valid / non-existent / zero / negative / non-numeric / overflow / injection.",
          "type": "text/plain"
        },
        "item": [
          {
            "id": "5b6b527c-9212-481c-9764-6e5349985bca",
            "name": "DP-001 | Existing id returns that product",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "{{existing_product_id}}"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "cf2a74c5-0ed6-4e4a-afa8-d67ccf2103a1",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Status is 200\", () => pm.response.to.have.status(200));",
                    "pm.test(\"Returned product is the one requested\", function () {",
                    "    pm.expect(String(pm.response.json().id)).to.eql(",
                    "        String(pm.environment.get(\"existing_product_id\"))",
                    "    );",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "22ee8c32-2ee3-496b-b4e2-a58a761c3b52",
            "name": "DP-002 | Non-existent id returns 404",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "999999"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "4092bca0-3074-4062-ad4c-00589bfcaeef",
                  "type": "text/javascript",
                  "exec": [
                    "// Spec/REST contract: an unknown resource is 404, not 200 with an empty body.",
                    "pm.test(\"Unknown product id returns 404\", function () {",
                    "    pm.response.to.have.status(404);",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "620caa6e-0307-4378-8a51-a784da3d5fe4",
            "name": "DP-003 | Non-numeric id is rejected",
            "request": {
