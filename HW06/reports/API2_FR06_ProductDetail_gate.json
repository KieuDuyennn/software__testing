      {
        "id": "27251ee7-0947-4220-92e2-510462992614",
        "name": "02 - State transitions",
        "description": {
          "content": "Existence states of a product: present -> deleted -> absent.",
          "type": "text/plain"
        },
        "item": [
          {
            "id": "af8ef58e-7a30-4c8e-bfc6-95cc2d38ca55",
            "name": "ST-001 | Deleted product is no longer retrievable",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "{{transient_product_id}}"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "prerequest",
                "script": {
                  "id": "8ec5ff59-c6f9-41f6-8431-bd9e0ccac4fe",
                  "type": "text/javascript",
                  "exec": [
                    "// Create then delete a product so this request observes the post-delete state.",
                    "// NOTE: POST/DELETE /api/products currently need no token - that itself is a",
                    "// finding for the security folder.",
                    "const base = pm.environment.get(\"base_url\");",
                    "const sid = pm.environment.get(\"student_id\");",
                    "pm.sendRequest({",
                    "    url: base + \"/api/products\",",
                    "    method: \"POST\",",
                    "    header: { \"Content-Type\": \"application/json\", \"X-Student-Id\": sid },",
                    "    body: { mode: \"raw\", raw: JSON.stringify({",
                    "        name: \"HW06 transient\", price: 1000, description: \"state fixture\",",
                    "        imageUrl: \"\", category_id: 1 }) }",
                    "}, function (err, res) {",
                    "    if (err || !res) { return; }",
                    "    const id = res.json().id;",
                    "    pm.environment.set(\"transient_product_id\", id);",
                    "    pm.sendRequest({",
                    "        url: base + \"/api/products/\" + id,",
                    "        method: \"DELETE\",",
                    "        header: { \"X-Student-Id\": sid }",
                    "    }, function () {",
                    "        console.log(\"[HW06] ST-001 fixture created+deleted product \" + id);",
                    "    });",
                    "});"
                  ]
                }
              },
              {
                "listen": "test",
                "script": {
                  "id": "60a29565-d644-43f8-81b4-6a6bdc44dfd7",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"A deleted product returns 404\", function () {",
                    "    pm.response.to.have.status(404);",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "26cc2841-fa94-4149-8a2d-d380b396a50a",
        "name": "03 - Security (SEC-01..SEC-07)",
        "description": {
          "content": "",
          "type": "text/plain"
        },
        "item": [
          {
            "id": "3a11f33b-215e-4536-9bc0-82301695b4df",
            "name": "SEC-05 | SQL injection through the :id path parameter",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "1 OR 1=1"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "93ea5446-c090-4df7-aa39-cd322049922c",
                  "type": "text/javascript",
                  "exec": [
                    "pm.test(\"Injection does not return the whole table\", function () {",
                    "    const b = pm.response.json();",
                    "    pm.expect(Array.isArray(b), \"response must not be a list of all products\").to.be.false;",
                    "});",
                    "pm.test(\"No 500 / SQL error leak\", function () {",
                    "    pm.expect(pm.response.code).to.not.eql(500);",
                    "    pm.expect(pm.response.text().toLowerCase()).to.not.include(\"sqlite\");",
                    "});"
                  ],
                  "_lastExecutionId": "5380c3ce-3ccb-4c83-ae86-6c6851a5d26d"
                }
              }
            ]
          }
        ],
        "event": []
      },
      {
        "id": "130d15d4-22e4-4642-a460-f396721e1bc9",
        "name": "04 - Schema validation",
        "description": {
          "content": "Run the same schema assertions across every id partition - type drift is id-dependent here.",
          "type": "text/plain"
        },
        "item": [
          {
            "id": "0e3182fe-bc98-489e-8018-0788e9197f7b",
            "name": "SCH-001 | Product schema holds for an odd id",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "1"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "182e66a7-5e23-4bf8-98dd-b26afa3a3f9e",
                  "type": "text/javascript",
                  "exec": [
                    "const schema = {",
                    "    type: \"object\",",
                    "    required: [\"id\", \"name\", \"price\", \"description\", \"imageUrl\", \"category_id\"],",
                    "    properties: {",
                    "        id: { type: \"integer\" },",
                    "        name: { type: \"string\" },",
                    "        price: { type: \"number\" },",
                    "        description: { type: \"string\" },",
                    "        imageUrl: { type: \"string\" },",
                    "        category_id: { type: \"integer\" }",
                    "    }",
                    "};",
                    "",
                    "pm.test(\"Response conforms to the product schema\", function () {",
                    "    pm.response.to.have.jsonSchema(schema);",
                    "});",
                    "",
                    "pm.test(\"price is a JSON number, not a string\", function () {",
                    "    pm.expect(pm.response.json().price).to.be.a(\"number\");",
                    "});"
                  ]
                }
              }
            ]
          },
          {
            "id": "41c731dc-6198-41f0-b7be-c0b906817cbc",
            "name": "SCH-002 | Product schema holds for an even id",
            "request": {
              "url": {
                "path": [
                  "api",
                  "products",
                  "2"
                ],
                "host": [
                  "{{base_url}}"
                ],
                "query": [],
                "variable": []
              },
              "method": "GET"
            },
            "response": [],
            "event": [
              {
                "listen": "test",
                "script": {
                  "id": "c14b5edb-7359-4f60-8b19-46d5d42694c1",
                  "type": "text/javascript",
                  "exec": [
                    "const schema = {",
                    "    type: \"object\",",
                    "    required: [\"id\", \"name\", \"price\", \"description\", \"imageUrl\", \"category_id\"],",
                    "    properties: {",
                    "        id: { type: \"integer\" },",
                    "        name: { type: \"string\" },",
                    "        price: { type: \"number\" },",
                    "        description: { type: \"string\" },",
                    "        imageUrl: { type: \"string\" },",
                    "        category_id: { type: \"integer\" }",
                    "    }",
                    "};",
                    "",
                    "// Same contract must hold regardless of the id's parity.",
                    "pm.test(\"Response conforms to the product schema\", function () {",
                    "    pm.response.to.have.jsonSchema(schema);",
                    "});",
                    "",
                    "pm.test(\"price is a JSON number, not a string\", function () {",
                    "    pm.expect(pm.response.json().price).to.be.a(\"number\");",
                    "});"
                  ]
                }
              }
            ]
          }
        ],
        "event": []
