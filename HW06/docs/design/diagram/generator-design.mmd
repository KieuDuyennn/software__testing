flowchart TB
    subgraph INPUTS["INPUTS"]
        direction LR
        SPEC["Markdown API specification"]
        REQ["FR / SEC requirements"]
        TARGET["Target endpoint<br/>Student ID: 23127184"]
    end

    subgraph PIPELINE["SEQUENTIAL GENERATION PIPELINE"]
        direction LR
        PARSE["STAGE 1 · PARSE CONTRACT<br/>Normalize parameters, schema,<br/>rules and authentication"]
        DOMAIN["STAGE 2 · DOMAIN PARTITIONS<br/>Valid, invalid and boundary values"]
        STATE["STAGE 3 · STATE TRANSITIONS<br/>Legal + complete illegal matrix"]
        SECURITY["STAGE 4 · SECURITY MODEL<br/>Anonymous, owner, other user, admin"]
        SCHEMA["STAGE 5 · SCHEMA VALIDATION<br/>Types, required fields and invariants"]
    end
    subgraph QUALITY["MANDATORY QUALITY GATES"]
        direction LR
        STATIC{"STAGE 6 · STATIC VALIDATOR<br/>IDs · duplicates · rule refs<br/>setup · oracle · mandatory header"}
        REVIEW{"STAGE 7 · HUMAN REVIEW<br/>VALID / INVALID / INCOMPLETE<br/>reason + correction"}
        APPROVED[("ApprovedCases<br/>canonical case set")]
    end
    RENDER["RENDERERS<br/>Inject + assert X-Student-Id: 23127184"]
    subgraph OUTPUTS["OUTPUT ARTEFACTS"]
        direction LR
        POSTMAN["Postman collections"]
        JSON["JSON exports"]
        EXCEL["Excel review table"]
        COVERAGE["Coverage + phase documents"]
    end
    DRYRUN{"DRY RUN<br/>Fresh seeded SUT · reachability · determinism"}
    TRIAGE["Bug triage<br/>Keep spec-derived oracle"]
    READY(["Verified test package"])

    SPEC -->|"contract text"| PARSE
    REQ -->|"FR / SEC rule IDs"| PARSE
    TARGET -->|"endpoint + identity"| PARSE
    PARSE -->|"EndpointModel"| DOMAIN
    DOMAIN -->|"CaseDraft[] + partitions"| STATE
    STATE -->|"CaseDraft[] + transitions"| SECURITY
    SECURITY -->|"CaseDraft[] + actors"| SCHEMA
    SCHEMA -->|"CaseDraft[] + schema oracles"| STATIC
    STATIC -->|"pass: ReviewQueue"| REVIEW
    STATIC -.->|"structural reject + reason"| DOMAIN
    REVIEW -->|"VALID / corrected"| APPROVED
    REVIEW -.->|"INVALID or INCOMPLETE<br/>feedback to producing stage"| DOMAIN
    APPROVED --> RENDER
    RENDER --> POSTMAN
    RENDER --> JSON
    RENDER --> EXCEL
    RENDER --> COVERAGE
    POSTMAN -->|"executable collection"| DRYRUN
    DRYRUN -->|"pass"| READY
    DRYRUN -->|"runtime mismatch"| TRIAGE
    DRYRUN -.->|"structural failure + reason"| STATIC

    classDef input fill:#e8f1ff,stroke:#2563eb,color:#172554,stroke-width:1.5px;
    classDef stage fill:#eefbf3,stroke:#16803c,color:#052e16,stroke-width:1.5px;
    classDef gate fill:#fff7df,stroke:#b77900,color:#422006,stroke-width:2px;
    classDef output fill:#f3edff,stroke:#7545b5,color:#2e1065,stroke-width:1.5px;
    classDef alert fill:#fff0f0,stroke:#c24141,color:#450a0a,stroke-width:1.5px;
    class SPEC,REQ,TARGET input;
    class PARSE,DOMAIN,STATE,SECURITY,SCHEMA,RENDER stage;
    class STATIC,REVIEW,DRYRUN gate;
    class APPROVED,POSTMAN,JSON,EXCEL,COVERAGE,READY output;
    class TRIAGE alert;
